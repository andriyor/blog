---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle dark mode">
			<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
				><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
			>
			<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
				><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
					><circle cx="12" cy="12" r="4"></circle><path
						d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path></g
				></svg
			>
		</button>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1em 1.5em;
	}
	/* Equal side columns keep the nav pill centered on the page. */
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1em;
	}
	#theme-toggle {
		justify-self: end;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/* Shared look for the nav pill and the round buttons. */
	.internal-links,
	.icon-button {
		border: 1px solid rgb(var(--gray-light));
		background: rgb(var(--bg));
		box-shadow: 0 2px 8px rgba(var(--black), 6%);
	}
	.internal-links {
		display: flex;
		padding: 0 0.5em;
		border-radius: 999px;
		font-size: 0.8em;
	}
	.internal-links a {
		position: relative;
		padding: 0.5em 0.9em;
		color: rgb(var(--black));
		font-weight: inherit;
		text-decoration: none;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: var(--accent);
	}
	.internal-links a.active::after {
		content: '';
		position: absolute;
		left: 0.6em;
		right: 0.6em;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
	}
	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border-radius: 50%;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.icon-button:hover {
		color: var(--accent);
	}
	:global([data-theme='dark']) .icon-moon,
	:global([data-theme='light']) .icon-sun {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 1em;
		}
	}
</style>
<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {}
	});
</script>
