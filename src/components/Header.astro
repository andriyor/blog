---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle dark mode">
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
					><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
				>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
					><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
						><circle cx="12" cy="12" r="4"></circle><path
							d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						></path></g
					></svg
				>
			</button>
			<a class="icon-button" href="https://github.com/andriyor" target="_blank">
				<span class="sr-only">Andrii Oriekhov on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1em 1.5em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/* Shared look for the nav pill and the round buttons. */
	.internal-links,
	.icon-button {
		border: 1px solid rgb(var(--gray-light));
		background: rgb(var(--bg));
		box-shadow: 0 2px 8px rgba(var(--black), 6%);
	}
	.internal-links {
		display: flex;
		padding: 0 0.5em;
		border-radius: 999px;
		font-size: 0.8em;
	}
	.internal-links a {
		position: relative;
		padding: 0.5em 0.9em;
		color: rgb(var(--black));
		font-weight: inherit;
		text-decoration: none;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: var(--accent);
	}
	.internal-links a.active::after {
		content: '';
		position: absolute;
		left: 0.6em;
		right: 0.6em;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border-radius: 50%;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.icon-button:hover {
		color: var(--accent);
	}
	:global([data-theme='dark']) .icon-moon,
	:global([data-theme='light']) .icon-sun {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 1em;
		}
		/* GitHub hides on mobile; the theme toggle stays. */
		.social-links a {
			display: none;
		}
	}
</style>
<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {}
	});
</script>
